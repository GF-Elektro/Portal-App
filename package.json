{
  "name": "gf-elektro-portal",
  "productName": "G&F Portal EU",
  "version": "1.0.66",
  "description": "Desktop app for G&F Portal EU – Portal for managing electrical installation projects",
  "main": "src/main.js",
  "author": {
    "name": "G&F Elektro s.r.o.",
    "email": "info@gfelektro.com",
    "url": "https://www.gfelektro.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GF-Elektro/Portal-App.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "start": "node scripts/run-electron.js .",
    "create-ico": "node scripts/create-ico.js",
    "logo:docs-transparent": "bash scripts/make-docs-logo-transparent.sh",
    "sync:docs-version": "node scripts/sync-docs-version.js",
    "build": "electron-builder build",
    "build:win": "electron-builder build --win",
    "build:win:store": "electron-builder build --win appx --publish never --config.win.executableName=GFPortalEU",
    "build:mac": "electron-builder build --mac dmg",
    "build:mac:mas": "bash scripts/build-mac-icon.sh && electron-builder build --mac mas --config.mac.executableName='GF Portal EU'",
    "verify:mas-signing": "bash scripts/verify-mas-signing.sh",
    "build:linux": "electron-builder build --linux",
    "smoke:electron": "node scripts/run-electron.js scripts/smoke-electron-api.js"
  },
  "build": {
    "appId": "com.gfelektro.portal",
    "productName": "G&F Portal EU",
    "artifactName": "GFElektroPortal-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "icon-512.png",
      "build/icon.ico",
      "build/mac-tray-gfTemplate.png",
      "build/mac-tray-g-and-fTemplate.png",
      "build/mac-tray-sparkTemplate.png",
      "build/mac-tray-g-bolt-fTemplate.png",
      "build/tray-gf.png",
      "build/tray-g-and-f.png",
      "build/tray-spark.png",
      "build/tray-g-bolt-f.png",
      "build/flags/*.svg"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Das G&F Portal EU benötigt Mikrofonzugriff für Sprachnachrichten, Diktat und Audiofunktionen.",
        "NSCameraUsageDescription": "Das G&F Portal EU benötigt Kamerazugriff für Belegfotos und Fotodokumentation auf der Baustelle.",
        "NSLocationWhenInUseUsageDescription": "Das G&F Portal EU kann optional den Standort für Tagesberichte speichern, wenn du die GPS-Erfassung aktivierst.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleIconFile": "AppIcon",
        "CFBundleIconName": "AppIcon"
      },
      "extraResources": [
        {
          "from": "build/macos/Assets.car",
          "to": "Assets.car"
        },
        {
          "from": "build/macos/AppIcon.icns",
          "to": "AppIcon.icns"
        }
      ]
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "icon-512.png",
      "iconSize": 128,
      "window": {
        "width": 600,
        "height": 380
      },
      "contents": [
        {
          "x": 160,
          "y": 170,
          "type": "file"
        },
        {
          "x": 440,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mas": {
      "identity": "G&F Elektro s.r.o. (3DKACDD8PH)",
      "forceCodeSigning": true,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "GFElektroPortal-${version}-Setup.${ext}"
    },
    "appx": {
      "identityName": "GFElektro.GFPortalEU",
      "publisher": "CN=A13AD157-0238-4037-901B-C007A13489C7",
      "publisherDisplayName": "G&F Elektro",
      "applicationId": "GFPortalEU",
      "displayName": "G&F Portal EU",
      "addAutoLaunchExtension": false,
      "languages": [
        "en-US",
        "de-DE",
        "sk-SK",
        "cs-CZ",
        "pl-PL",
        "hu-HU",
        "uk-UA"
      ],
      "capabilities": [
        "internetClient",
        "microphone",
        "webcam",
        "location"
      ],
      "artifactName": "GFElektroPortal-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "icon-512.png",
      "executableName": "GFElektroPortal"
    },
    "deb": {
      "packageName": "gfe-portal-eu",
      "maintainer": "G&F Elektro s.r.o. <info@gfelektro.com>"
    },
    "publish": {
      "provider": "github",
      "owner": "GF-Elektro",
      "repo": "Portal-App",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
