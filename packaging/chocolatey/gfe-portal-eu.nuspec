<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>gfe-portal-eu</id>
    <version>1.0.42</version>
    <title>G&amp;F Portal EU</title>
    <authors>G&amp;F Elektro s.r.o.</authors>
    <projectUrl>https://github.com/GF-Elektro/Portal-App</projectUrl>
    <packageSourceUrl>https://github.com/GF-Elektro/Portal-App</packageSourceUrl>
    <docsUrl>https://docs.gfelektro.com/</docsUrl>
    <licenseUrl>https://github.com/GF-Elektro/Portal-App/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Desktop client for the G&amp;F Elektro electrical-installation portal.</summary>
    <description><![CDATA[G&F Portal EU is the Windows desktop app for the G&F Elektro portal, used to manage electrical installation projects. It opens https://portal.gfelektro.com in its own window, stays in the system tray, and shows native notifications.

You need an existing G&F Portal account. Sign in with the same account as on the website. This package does not create an account.

The installer is the Authenticode-signed Setup.exe from the GitHub release for this version.]]></description>
    <copyright>Copyright 2026 G&amp;F Elektro s.r.o.</copyright>
    <tags>gfelektro portal electrical</tags>
  </metadata>
</package>
